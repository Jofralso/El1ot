# ELIOT Configuration Template
# Copy this to .env and fill in values for your environment

# Environment
ELIOT_ENV=development
ELIOT_LOG_LEVEL=INFO

# Hardware target (jetson-orin-nano, jetson-orin, raspberry-pi, dev-machine)
HARDWARE_TARGET=dev-machine

# API
CORE_PORT=8000
CORE_HOST=0.0.0.0

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# Prometheus
PROMETHEUS_PORT=9090

# AI Models (Phase 2)
MODEL_CACHE_DIR=./models
PRIMARY_MODEL=qwen2.5-coder-3b-pentest
REASONING_MODEL=deepseek-r1-distill-qwen-7b
EMBEDDING_MODEL=nomic-embed-text
CUDA_ENABLED=false
LLAMA_CPP_HOST=llama-cpp
LLAMA_CPP_PORT=8080

# Knowledge Engine (Phase 3)
VECTORDB_PATH=./data/vectordb
CHROMADB_HOST=chromadb
CHROMADB_PORT=8000

# Voice (Phase 4)
WAKE_WORD=eliot
MIC_DEVICE_INDEX=0
SPEAKER_DEVICE_INDEX=0
WHISPER_MODEL=base
TTS_VOICE=en_US-lessac-medium

# Vision (Phase 5)
CAMERA_DEVICE_INDEX=0
FACE_RECOGNITION_THRESHOLD=0.6

# Avatar (Phase 6)
AVATAR_ENABLED=true
AVATAR_WS_PORT=8765

# MQTT (Raspberry Pi)
MQTT_HOST=mqtt
MQTT_PORT=1883

# Security
ENABLE_AUTH=false
ENABLE_AUDIT_LOG=true
SECURITY_DIR=security
